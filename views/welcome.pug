doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Farm Connect - Welcome
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css")
    link(rel="stylesheet", href="/style.css")

  body(data-page="welcome")
    // Navbar
    nav.navbar.navbar-expand-lg.navbar-light.bg-light.shadow-sm
      .container
        a.navbar-brand.fw-bold(href="/") Farm Connect
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse.justify-content-end
          ul.navbar-nav.me-3
            li.nav-item
              a.nav-link(href="/") Home
            li.nav-item
              a.nav-link(href="/products/market") Market
            li.nav-item
              a.nav-link(href="/logout") Logout

    // Welcome Text
    .container.text-center
      h3.welcome-text Welcome To Farm Connect, #{user.name}!

      // Region Change Form
      .mt-4.mb-4
        h5 Change Your Region
        form(action="/change-region" method="POST")
          .mb-3
            select.form-select#regRegion(name="region" required)
              option(selected disabled value="") Select region
              option(value="Eastern" selected=user.region === "Eastern") Eastern
              option(value="Central" selected=user.region === "Central") Central
              option(value="Northern" selected=user.region === "Northern") Northern
              option(value="Western" selected=user.region === "Western") Western
          button.btn.btn-secondary(type="submit") Update Region

      // Buttons
      .mt-4
        button#dashboardBtn.btn.btn-custom(onclick="window.location.href='/dashboard'") Dashboard
        button#regionBtn.btn.btn-custom(onclick="window.location.href='/products/market'") Browse Products on Market



    // Footer
    .footer
      div
        i.bi.bi-twitter-x
        i.bi.bi-facebook
        i.bi.bi-youtube
      p.mt-3.mb-1 henrywandera138@gmail.com
      p.mb-0 +256767127641

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")
