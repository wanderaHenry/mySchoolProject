doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Registration Page
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet", href="/style.css")

  body(data-page="register")
    // Navbar
    nav.navbar.navbar-expand-lg.navbar-light.bg-light.shadow-sm
      .container
        a.navbar-brand.fw-bold(href="/") Farm Connect
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse.justify-content-end
          ul.navbar-nav.me-3
            li.nav-item
              a.nav-link(href="/") Home
            li.nav-item
              a.nav-link(href="/about") About
            li.nav-item
              a.nav-link(href="/contact") Contact
            li.nav-item
              a.nav-link(href="/login") Login
            li.nav-item
              a.nav-link(href="/register") Register

    // Registration Card
    .register-card
      h4.text-center.mb-4.fw-bold Create your account

      form#registerForm(action="/register" method="POST")
        .mb-3
          select.form-select#regRole(name="role" required)
            option(selected disabled value="") Select role
            option(value="customer") Customer
            option(value="farmer") Farmer
            option(value="aggregator") Aggregator / Cooling Center

        .mb-3
          select.form-select#regRegion(name="region" required)
            option(selected disabled value="") Select region
            option(value="Eastern") Eastern
            option(value="Central") Central
            option(value="Northern") Northern
            option(value="Western") Western

        .mb-3
          input.form-control#regName(type="text", name="name", placeholder="Full Name", required)

        .mb-3
          input.form-control#regEmail(type="email", name="email", placeholder="Email", required)

        .mb-3
          input.form-control#regPhone(type="tel", name="phone", placeholder="Phone Number (256XXXXXXXXX)", required)

        .mb-3
          input.form-control#regPassword(type="password", name="password", placeholder="Password", required)

        .mb-3
          input.form-control#regConfirmPassword(type="password", name="confirmPassword", placeholder="Confirm Password", required)

        button.btn.btn-register.w-100(type="submit") Register

      p.text-center.mt-3
        | Already have an account? 
        a(href="/login") Log In

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")
    script.
      document.querySelector('form').addEventListener('submit', function(e) {
        const phone = document.getElementById('regPhone').value;
        const phoneRegex = /^256\d{9}$/;
        if (!phoneRegex.test(phone.replace(/^\+/, ''))) {
          e.preventDefault();
          alert('Phone number must be in format 256XXXXXXXXX (e.g., 256700000000)');
        }
      });
