doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Agric Produce Market
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet")
    link(rel="stylesheet", href="/style.css")
    style.
      .card {
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
      }
      .btn-primary {
        background: linear-gradient(135deg, #007bff, #0056b3);
        border: none;
      }
      .btn-primary:hover {
        background: linear-gradient(135deg, #0056b3, #004085);
      }

  body(data-page="market")
    // Navbar
    nav.navbar.navbar-expand-lg.navbar-light.bg-light.shadow-sm
      .container
        a.navbar-brand.fw-bold(href="/welcome") Farm Connect
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse.justify-content-end
          ul.navbar-nav.me-3
            li.nav-item
              a.nav-link(href="/welcome") Home
            li.nav-item
              a.nav-link(href="/products/market") Market
            if user.role === "farmer" || user.role === "aggregator"
              li.nav-item
                a.nav-link(href="/dashboard") Dashboard
              li.nav-item
                a.nav-link(href="/products") My Products
              li.nav-item
                a.nav-link(href="/orders") Orders
            else if user.role === "customer"
              li.nav-item
                a.nav-link(href="/customer/dashboard") Dashboard
              li.nav-item
                a.nav-link(href="/orders") My Orders

            li.nav-item
              a.nav-link(href="/logout") Logout

    // Heading
    .container.text-center.mt-4
      h4 Welcome To Farm-Connect Market, #{user.name}

    .container.mt-3
      .d-flex.justify-content-center.flex-wrap.gap-2
        button.btn.btn-outline-secondary.filter-btn.active(type="button" data-filter="all") All Products
        button.btn.btn-outline-success.filter-btn(type="button" data-filter="farmer") Direct from Farmers
        button.btn.btn-outline-primary.filter-btn(type="button" data-filter="aggregator") Aggregators Only

    // Product Grid
    .container.mt-4
      if products.length === 0
        p.text-center.text-muted No products available in the market yet.
      else
        .row.row-cols-1.row-cols-md-3.g-4.justify-content-center
          each product in products
              .col.product-card(data-seller-role=product.seller ? product.seller.role : "unknown")
              .card.h-100
                if product.image
                  img.card-img-top(src=product.image, alt=product.name)
                else
                  img.card-img-top(src="https://via.placeholder.com/120x100", alt=product.name)
                .card-body
                  h5.card-title #{product.name}
                  p.card-text #{product.description}
                  p.text-success UGX #{product.price.toLocaleString()}
                  if product.quantity <= 0
                    span.badge.bg-dark.mb-2 Taken
                  if product.seller && product.seller.role === "farmer"
                    span.badge.bg-success.mb-2 Direct from Farmer
                  else if product.seller && product.seller.role === "aggregator"
                    span.badge.bg-primary.mb-2 Aggregator / Cooling Center
                  else
                    span.badge.bg-secondary.mb-2 Unknown seller
                  p.text-muted Seller: #{product.seller ? (product.seller.businessName || product.seller.name) : "Unknown"}
                  p.text-muted Region: #{product.seller ? product.seller.region : "Unknown"}
                  if user.role === "customer" && product.seller && product.seller.region
                    if product.seller.region !== user.region
                      p.alert.alert-warning.py-2.mb-2
                        | This seller is in a different region. A delivery fee of UGX #{product.deliveryFee.toLocaleString()} will apply.
                    else
                      p.text-muted.mb-2 Delivery fee: UGX #{product.deliveryFee.toLocaleString()} (same region)
                  p.text-muted Contact: #{product.seller ? product.seller.phone : "N/A"}
                  p.text-muted Quantity Available: #{product.quantity} kg
                  if product.quantity <= 0
                    button.btn.btn-dark.btn-sm(type="button" disabled) Taken
                  else if user.role === "farmer" || user.role === "aggregator"
                    button.btn.btn-secondary.btn-sm(type="button" disabled) Seller accounts cannot place orders
                  else
                    form(action="/orders/create", method="POST")
                      input(type="hidden", name="productId", value=product._id)
                      .input-group.mb-2
                        input.form-control(type="number", name="quantity", placeholder="Quantity", min="1", max=product.quantity, required)
                      button.btn.btn-primary.btn-sm(type="submit") Request Product

    // Footer
    .footer.bg-light.text-center.py-3.mt-5
      p &copy; #{new Date().getFullYear()} Farm Connect
      p Contact: henrywandera138@gmail.com | +256 767 127 641

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")
    script.
      document.querySelectorAll('.filter-btn').forEach(function (button) {
        button.addEventListener('click', function () {
          const filter = button.dataset.filter;
          document.querySelectorAll('.filter-btn').forEach(function (item) {
            item.classList.toggle('active', item === button);
          });
          document.querySelectorAll('.product-card').forEach(function (card) {
            card.classList.toggle('d-none', filter !== 'all' && card.dataset.sellerRole !== filter);
          });
        });
      });
