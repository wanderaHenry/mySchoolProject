doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Farm Connect - Orders
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="/style.css")

  body
    // Navbar
    nav.navbar.navbar-expand-lg.navbar-light.bg-light.shadow-sm
      .container
        a.navbar-brand.fw-bold(href="/welcome") Farm Connect
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse.justify-content-end
          ul.navbar-nav.me-3
            li.nav-item
              a.nav-link(href="/welcome") Home
            li.nav-item
              a.nav-link(href="/products/market") Market
            if user && (user.role === "farmer" || user.role === "aggregator")
              li.nav-item
                a.nav-link(href="/dashboard") Dashboard
              li.nav-item
                a.nav-link(href="/products") My Products
              li.nav-item
                a.nav-link(href="/orders") Orders
            else if user && user.role === "customer"
              li.nav-item
                a.nav-link(href="/customer/dashboard") Dashboard
              li.nav-item
                a.nav-link(href="/orders") My Orders
            li.nav-item
              a.nav-link(href="/settings") Settings
            li.nav-item
              a.nav-link(href="/logout") Logout

    // Orders Section
    .container.mt-5
      h3.text-center.mb-4 Orders Dashboard

      if orders.length === 0
        p.text-center.text-muted No orders yet.
      else
        table.table.table-striped.table-hover
          thead
            tr
              th Product
              th Buyer
              th Subtotal
              th Delivery
              th Total
              th Status
              th Action
          tbody
            each order in orders
              - var subtotal = order.product ? order.quantity * order.product.price : 0
              - var deliveryFee = order.deliveryFee || 0
              - var totalAmount = order.totalAmount || subtotal + deliveryFee
              tr
                td #{order.product ? order.product.name : 'Product Deleted'}
                td #{order.customerId ? order.customerId.name : 'Customer Deleted'}
                td UGX #{subtotal.toLocaleString()}
                td UGX #{deliveryFee.toLocaleString()}
                td.fw-bold UGX #{totalAmount.toLocaleString()}
                td
                  case order.status
                    when 'pending'
                      span.badge.bg-warning.text-dark Pending
                    when 'approved'
                      span.badge.bg-success Approved
                    when 'rejected'
                      span.badge.bg-danger Rejected
                    when 'paid'
                      span.badge.bg-primary Paid
                    when 'shipped'
                      span.badge.bg-purple Shipped
                    when 'delivered'
                      span.badge.bg-info Delivered
                    default
                      span.badge.bg-secondary= order.status
                td
                  if order.status === 'pending'
                    form(action="/orders/update", method="POST", class="d-flex align-items-center")
                      input(type="hidden", name="orderId", value=order._id)
                      select.form-select.form-select-sm(name="status")
                        option(value="approved") Approve
                        option(value="rejected") Reject
                      button.btn.btn-success.btn-sm.ms-2(type="submit") Update
                  else if order.status === 'paid'
                    form(action="/orders/update", method="POST")
                      input(type="hidden", name="orderId", value=order._id)
                      input(type="hidden", name="status", value="shipped")
                      button.btn.btn-primary.btn-sm(type="submit") Mark as Shipped
                  else if order.status === 'shipped'
                    form(action="/orders/update", method="POST")
                      input(type="hidden", name="orderId", value=order._id)
                      input(type="hidden", name="status", value="delivered")
                      button.btn.btn-info.btn-sm(type="submit") Mark as Delivered
                  else
                    span.text-muted No action

    // Scripts
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
